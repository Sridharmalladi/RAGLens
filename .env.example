# OpenRouter API key. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional. Shown in OpenRouter dashboard rankings and sent as the request referer.
OPENROUTER_APP_NAME=RAGLens
OPENROUTER_APP_URL=https://github.com/Sridharmalladi/RAGLens

# Optional. Override the SQLite path (default: raglens.db in project root)
# DB_PATH=raglens.db
