# OpenRouter API key. Create one at https://openrouter.ai/keys
# Used for answer generation and LLM-as-judge scoring.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional. Shown in OpenRouter dashboard rankings and sent as the request referer.
OPENROUTER_APP_NAME=RAGLens
OPENROUTER_APP_URL=https://github.com/Sridharmalladi/RAGLens

# ── Retrieval backend ────────────────────────────────────────────────────────
# Leave unset to auto-detect: "local" when sentence-transformers is installed
# (requirements-full.txt / Docker), otherwise "hosted".
# RETRIEVAL_BACKEND=hosted

# Required when RETRIEVAL_BACKEND=hosted. A Hugging Face token (read scope is
# enough) for the Inference API that embeds queries and runs the reranker.
# HF_TOKEN=hf_xxx

# ── Host tuning ─────────────────────────────────────────────────────────────
# Set to 0 on hosts whose Python runtime buffers streamed responses (Vercel).
# STREAM_RESPONSES=1

# Set to 0 on scale-to-zero / serverless hosts so the 8h background eval job
# does not re-run against a fresh empty DB on every cold start.
# ENABLE_SCHEDULER=1

# Override the SQLite path (serverless: point at a writable dir like /tmp).
# DB_PATH=/tmp/raglens.db
